                    <button onclick="runSimulation()" class="mt-4 w-full py-2 bg-teal-600 hover:bg-teal-700 text-white font-medium rounded text-sm shadow-sm transition-colors">
                        Execute New Simulation Run
                    </button>
                </div>
            </div>

            <!-- Barriers Grid -->
             <div class="mt-8">
                <h3 class="text-lg font-bold text-stone-800 mb-4">Barriers to Entry (Why Google Won't Build This)</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- Barrier 1 -->
                    <div class="bg-white p-5 rounded border border-stone-200">
                        <div class="text-red-500 mb-2">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                        </div>
                        <h4 class="font-bold text-stone-700 text-sm">1. Liability Trap</h4>
                        <p class="text-xs text-stone-500 mt-2">Finance needs 100% accuracy. AI is probabilistic. Big Tech fears lawsuits.</p>
                    </div>
