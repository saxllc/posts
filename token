                        </div>
                        <div>
                            <div class="flex justify-between text-xs font-bold text-stone-700 mb-1">
                                <span>Protocol Maturity</span>
                                <span>40%</span>
                            </div>
                            <div class="w-full bg-stone-200 rounded-full h-2">
                                <div class="bg-orange-500 h-2 rounded-full" style="width: 40%"></div>
                            </div>
                            <p class="text-[10px] text-stone-400 mt-1">Beckn/ONDC live but not universal.</p>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs font-bold text-stone-700 mb-1">
                                <span>Big Tech Interest</span>
                                <span>15%</span>
                            </div>
                            <div class="w-full bg-stone-200 rounded-full h-2">
                                <div class="bg-red-500 h-2 rounded-full" style="width: 15%"></div>
