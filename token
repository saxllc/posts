    <!-- Footer -->
    <footer class="bg-white border-t border-stone-200 mt-auto py-6">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-stone-400">
            Token Observatory Studio • Internal Proposal Draft • 2025
        </div>
    </footer>

    <script>
        // --- State Management ---
        const appState = {
            currentTab: 'mission',
            simulationRunning: false,
            identityStep: 'transact'
        };

        // --- Navigation Logic ---
        const tabs = [
            { id: 'mission', label: 'Mission Control' },
            { id: 'architecture', label: 'Architecture' },
            { id: 'trust', label: 'Valley of Trust' },
            { id: 'strategy', label: 'Strategy Lab' }
        ];

        function initNav() {
            const navContainer = document.getElementById('nav-links');
            navContainer.innerHTML = tabs.map(tab => `
                <button 
                    onclick="switchTab('${tab.id}')"
                    class="${appState.currentTab === tab.id ? 'border-teal-500 text-stone-900' : 'border-transparent text-stone-500 hover:border-stone-300 hover:text-stone-700'} inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors"
                    id="nav-${tab.id}"
                >
                    ${tab.label}
                </button>
            `).join('');
        }

        function switchTab(tabId) {
            appState.currentTab = tabId;
            
            // Update UI
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.getElementById(`tab-${tabId}`).classList.add('active');
            
            // Re-render nav to update active state
            initNav();
        }

        // --- Identity Arc Interaction ---
        const identityData = {
            'secure': { title: 'Securing Identity', desc: 'Impatience & Frustration. Fraud related distress. We need to move users past this.' },
            'update': { title: 'Updating Identity', desc: 'Disengaged & Passive. Users feel "Let Down".' },
            'transact': { title: 'Transactional', desc: 'Convenience related. Pleasant experience. This is where current products live.' },
            'leverage': { title: 'Leveraging Identity', desc: 'Consistent performance. Delightful experience. The goal: Evangelist users.' }
        };

        function updateIdentityDetails(step) {
            const box = document.getElementById('identity-detail-box');
            const data = identityData[step];
            
            // Simple animation
            box.style.opacity = '0.5';
            setTimeout(() => {
                box.innerHTML = `<h3 class="font-bold text-stone-800">Phase: ${data.title}</h3><p class="text-sm text-stone-600 mt-1">${data.desc}</p>`;
                box.style.opacity = '1';
                
                // Color coding borders
                if(step === 'secure') box.className = "mt-6 bg-stone-50 p-4 rounded border-l-4 border-red-500 transition-all duration-300";
                if(step === 'update') box.className = "mt-6 bg-stone-50 p-4 rounded border-l-4 border-orange-400 transition-all duration-300";
                if(step === 'transact') box.className = "mt-6 bg-stone-50 p-4 rounded border-l-4 border-teal-500 transition-all duration-300";
                if(step === 'leverage') box.className = "mt-6 bg-stone-50 p-4 rounded border-l-4 border-blue-600 transition-all duration-300";
            }, 200);
        }

        // --- Simulation Terminal Logic ---
        const simLog = document.getElementById('sim-terminal');
        const simMessages = [
            "> INITIALIZING SIM_HARBOR_V1...",
            "> LOAD_USER_CONTEXT: { literacy: 'low', lang: 'marathi' }",
            "> GENERATING RHETORICAL_PATH_B...",
            "> AGENT_ACTION: 'Pre-fill Form 12B'",
            "> WARNING: LIABILITY CHECK PENDING...",
            "> SIMULATION_MODE: ACTIVE (No DB Write)",
            "> VALIDATING INPUTS AGAINST CANONICAL RULES...",
            "> SUCCESS: Input matches formal reqs.",
            "> TRUST_SCORE_DELTA: +15",
            "> READY FOR COMMIT."
        ];

        function runSimulation() {
            simLog.innerHTML = "";
            let i = 0;
            appState.simulationRunning = true;
            
            const interval = setInterval(() => {
                if (i >= simMessages.length) {
                    clearInterval(interval);
                    appState.simulationRunning = false;
                    return;
                }
                const msg = document.createElement('div');
                msg.className = "mb-1";
                // Color coding log
                if (simMessages[i].includes("WARNING")) msg.className = "mb-1 text-yellow-400";
                if (simMessages[i].includes("SUCCESS")) msg.className = "mb-1 text-green-400";
                
                msg.innerText = simMessages[i];
                simLog.appendChild(msg);
                simLog.scrollTop = simLog.scrollHeight;
                i++;
            }, 600);
        }

        // --- Charts Initialization ---
        document.addEventListener('DOMContentLoaded', () => {
            initNav();
            runSimulation(); // Auto run once

            // 1. Literacy Chart (Doughnut)
            const ctxLiteracy = document.getElementById('literacyChart').getContext('2d');
            new Chart(ctxLiteracy, {
                type: 'doughnut',
                data: {
                    labels: ['Digital Native', 'Assistive Needs', 'Digitally Illiterate'],
                    datasets: [{
                        data: [15, 35, 50], // Hypothetical split based on 50 crore population context
                        backgroundColor: ['#d6d3d1', '#5eead4', '#0f766e'], // Stone-300, Teal-300, Teal-700
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right', labels: { boxWidth: 10, font: { size: 10 } } }
                    }
                }
            });

            // 2. Trust Valley Chart (Scatter/Bubble approximation)
            const ctxTrust = document.getElementById('trustChart').getContext('2d');
            new Chart(ctxTrust, {
                type: 'scatter',
                data: {
                    datasets: [
                        {
                            label: 'Current Big Tech (Assistive)',
                            data: [{x: 20, y: 20}],
                            backgroundColor: '#ef4444', // Red
                            pointRadius: 15
                        },
                        {
                            label: 'The Valley of Trust',
                            data: [{x: 50, y: 10}, {x: 55, y: 12}, {x: 45, y: 8}],
                            backgroundColor: '#e5e5e5', // Grey
                            pointRadius: 5
                        },
                        {
                            label: 'Tokenized UI (Agentic)',
                            data: [{x: 85, y: 85}],
                            backgroundColor: '#0d9488', // Teal
                            pointRadius: 15
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { 
                            title: { display: true, text: 'Autonomy (Agency)' },
                            min: 0, max: 100 
                        },
                        y: { 
                            title: { display: true, text: 'Value Generated' },
                            min: 0, max: 100 
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: (ctx) => {
                                    if(ctx.raw.x < 30) return "Safe but Low Value (Summarization)";
                                    if(ctx.raw.x > 80) return "High Value (Simulation Enabled)";
                                    return "The Liability Trap";
                                }
                            }
                        }
                    }
                }
            });
        });

        // --- Token Logic Toggle ---
        function toggleTokenLogic() {
            // Visual effect only
            alert("In a full implementation, this would trigger the Generative Layer to re-render the component based on new cultural metadata.");
        }

    </script>
</body>
