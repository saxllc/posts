    <!-- Main Content Area -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- INTRO CONTEXT (Visible on all tabs) -->
        <div class="mb-8 border-b border-stone-200 pb-6">
            <h1 class="text-3xl font-bold text-stone-900 mb-2">Architecting the Probabilistic UI</h1>
            <p class="text-lg text-stone-600 max-w-3xl">
                Moving from pixel-deterministic interfaces to tokenized, rhetorical journeys. 
                Bridging the "Valley of Trust" for a billion users.
            </p>
        </div>

        <!-- TAB: MISSION CONTROL -->
        <div id="tab-mission" class="tab-content active">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                <!-- Context Block -->
                <div class="lg:col-span-2 bg-white rounded-lg p-6 rational-card">
                    <h2 class="text-xl font-semibold mb-4 text-stone-800">The Mission: Billion Users, Million Journeys</h2>
                    <p class="text-stone-600 mb-4">
                        Current digital public infrastructure (DPI) has successfully digitized identity (Aadhaar, PAN). 
                        However, the user experience layer remains rigid and "canonical." 
                        To reach the next 50 crore users, we must accommodate diverse literacy levels and contexts through "Rhetorical Journeys."
                    </p>
                    <div class="grid grid-cols-2 gap-4 mt-6">
                        <div class="bg-stone-50 p-4 rounded border border-stone-100">
                            <h3 class="font-bold text-stone-700 text-sm uppercase">The Challenge</h3>
                            <p class="text-sm text-stone-500 mt-1">Formal systems demand 100% accuracy. Humans are probabilistic and messy.</p>
                        </div>
                        <div class="bg-stone-50 p-4 rounded border border-stone-100">
                            <h3 class="font-bold text-stone-700 text-sm uppercase">The Solution</h3>
                            <p class="text-sm text-stone-500 mt-1">A Generative UI layer that translates user intent (Rhetoric) into system actions (Canonical).</p>
                        </div>
                    </div>
                </div>

                <!-- Stats Chart -->
                <div class="bg-white rounded-lg p-6 rational-card flex flex-col">
