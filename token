                        <canvas id="literacyChart"></canvas>
                    </div>
                    <p class="text-xs text-center text-stone-400 mt-2">Target demographic requires non-textual interfaces.</p>
                </div>
            </div>

            <!-- The Arc of Identity -->
            <div class="bg-white rounded-lg p-6 rational-card">
                <h2 class="text-xl font-semibold mb-6 text-stone-800">The Arc of Identity</h2>
                <div class="relative pt-8 pb-4">
                    <!-- Progress Bar Background -->
                    <div class="h-2 bg-stone-100 rounded-full w-full absolute top-1/2 transform -translate-y-1/2"></div>
                    
                    <!-- Steps -->
                    <div class="relative flex justify-between items-center z-10">
                        <!-- Step 1 -->
                        <div class="flex flex-col items-center group cursor-pointer" onclick="updateIdentityDetails('secure')">
                            <div class="w-8 h-8 rounded-full bg-red-100 border-2 border-red-500 flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                                <span class="text-red-700 text-xs font-bold">1</span>
                            </div>
                            <span class="text-xs font-semibold text-stone-600">Securing</span>
                            <span class="text-[10px] text-stone-400 uppercase mt-1">Skeptical</span>
                        </div>
                        <!-- Step 2 -->
                        <div class="flex flex-col items-center group cursor-pointer" onclick="updateIdentityDetails('update')">
                            <div class="w-8 h-8 rounded-full bg-orange-100 border-2 border-orange-400 flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                                <span class="text-orange-700 text-xs font-bold">2</span>
                            </div>
                            <span class="text-xs font-semibold text-stone-600">Updating</span>
                            <span class="text-[10px] text-stone-400 uppercase mt-1">Let Down</span>
                        </div>
                        <!-- Step 3 -->
                        <div class="flex flex-col items-center group cursor-pointer" onclick="updateIdentityDetails('transact')">
                            <div class="w-8 h-8 rounded-full bg-teal-100 border-2 border-teal-500 flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                                <span class="text-teal-700 text-xs font-bold">3</span>
                            </div>
                            <span class="text-xs font-semibold text-stone-600">Transactional</span>
                            <span class="text-[10px] text-stone-400 uppercase mt-1">Trusted</span>
