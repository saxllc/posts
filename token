                        <!-- Step 4 -->
                        <div class="flex flex-col items-center group cursor-pointer" onclick="updateIdentityDetails('leverage')">
                            <div class="w-8 h-8 rounded-full bg-blue-100 border-2 border-blue-600 flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                                <span class="text-blue-700 text-xs font-bold">4</span>
                            </div>
                            <span class="text-xs font-semibold text-stone-600">Leveraging</span>
                            <span class="text-[10px] text-stone-400 uppercase mt-1">Evangelist</span>
                        </div>
                    </div>
                </div>
                
                <!-- Dynamic Detail Box -->
                <div id="identity-detail-box" class="mt-6 bg-stone-50 p-4 rounded border-l-4 border-teal-500 transition-all duration-300">
